# mime library
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./types.alya"
import "./core/db.alya"
import "./core/charset.alya"
import "./core/parser.alya"

# ═══════════════════════════════════════════════════════════════
# Public API Facade
# ═══════════════════════════════════════════════════════════════

## Looks up MIME essence for a path, filename, or extension (e.g. "text/html").
## Returns default_type ("application/octet-stream" by default) if not found.
pub function lookup(path_or_ext, default_type = "application/octet-stream")
    let ext = extract_ext(path_or_ext)
    if len(ext) > 0
        let m = db_lookup_ext(ext)
        if len(m) > 0
            return m
        end
    end
    return default_type
end

## Looks up raw MIME essence strictly by extension without fallback (returns "" if unknown).
pub function type_by_ext(ext)
    let clean = extract_ext(ext)
    if len(clean) == 0
        return ""
    end
    return db_lookup_ext(clean)
end

## Returns full Content-Type header with charset if applicable (e.g. "text/html; charset=utf-8").
pub function content_type(path_or_ext, default_type = "application/octet-stream")
    let ext = extract_ext(path_or_ext)
    let essence = ""
    if len(ext) > 0
        essence = db_lookup_ext(ext)
    end

    if len(essence) == 0
        essence = default_type
    end

    return format_content_type(essence)
end

## Reverse lookup: returns default file extension for a MIME type (e.g. "text/html" -> "html").
pub function extension(mime_type)
    let s = _mime_trim(mime_type)
    let semi = _mime_index_of(s, ";")
    let essence = s
    if semi >= 0
        essence = substring(s, 0, semi)
    end
    essence = lower(_mime_trim(essence))
    return db_lookup_mime_ext(essence)
end

## Returns 1 if given path, extension, or MIME type is text-based / human readable, 0 otherwise.
pub function is_text(path_or_mime)
    let ext = extract_ext(path_or_mime)
    let essence = ""
    if len(ext) > 0
        essence = db_lookup_ext(ext)
    end

    if len(essence) == 0
        let s = _mime_trim(path_or_mime)
        let semi = _mime_index_of(s, ";")
        if semi >= 0
            s = substring(s, 0, semi)
        end
        essence = lower(_mime_trim(s))
    end

    return is_text_type(essence)
end

## Returns 1 if given path, extension, or MIME type is binary data, 0 otherwise.
pub function is_binary(path_or_mime)
    if is_text(path_or_mime) == 1
        return 0
    end
    return 1
end

## Returns default charset for a given path, extension, or MIME type ("utf-8" or "").
pub function charset(path_or_mime)
    let ext = extract_ext(path_or_mime)
    let essence = ""
    if len(ext) > 0
        essence = db_lookup_ext(ext)
    end

    if len(essence) == 0
        let s = _mime_trim(path_or_mime)
        let semi = _mime_index_of(s, ";")
        if semi >= 0
            s = substring(s, 0, semi)
        end
        essence = lower(_mime_trim(s))
    end

    return default_charset_for_mime(essence)
end

## Appends charset parameter to a MIME essence string.
pub function with_charset(mime_essence, charset_name = "utf-8")
    let s = _mime_trim(mime_essence)
    return s + "; charset=" + charset_name
end

## Parses a Content-Type header string into a structured MimeType instance.
pub function parse(header_str)
    return parse_content_type(header_str)
end

## Formats a MimeType instance back into a Content-Type string.
pub function format(mime_obj)
    if len(mime_obj.charset) > 0
        return mime_obj.essence + "; charset=" + mime_obj.charset
    end
    return mime_obj.essence
end

## # mime
##
## MIME library for Alya.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Looks up media types by path or extension, classifies text versus binary
## payloads, and parses Content-Type headers into structured models.

import "./types.alya"
import "./core/db.alya"
import "./core/charset.alya"
import "./core/parser.alya"

# ═══════════════════════════════════════════════════════════════
# Public API Facade
# ═══════════════════════════════════════════════════════════════

## Looks up the MIME essence for a path, filename, or extension.
##
## ### Parameters
## - `path_or_ext`: Path, filename, or extension string.
## - `default_type`: Fallback essence. Defaults to `"application/octet-stream"`.
##
## ### Returns
## The MIME essence string (e.g. `"text/html"`).
##
## ### Examples
## ```alya
## say lookup("page.html") # "text/html"
## ```
pub function lookup(path_or_ext: string, default_type: string = "application/octet-stream") -> string
    let ext = extract_ext(path_or_ext)
    if len(ext) > 0
        let m = db_lookup_ext(ext)
        if len(m) > 0
            return m
        end
    end
    return default_type
end

## Looks up the raw MIME essence strictly by extension (`""` when unknown).
##
## ### Parameters
## - `ext`: Extension or path string.
##
## ### Returns
## The MIME essence string, or `""` when unknown.
pub function type_by_ext(ext: string) -> string
    let clean = extract_ext(ext)
    if len(clean) == 0
        return ""
    end
    return db_lookup_ext(clean)
end

## Returns the full Content-Type header with charset when applicable.
##
## ### Parameters
## - `path_or_ext`: Path, filename, or extension string.
## - `default_type`: Fallback essence. Defaults to `"application/octet-stream"`.
##
## ### Returns
## The Content-Type header string (e.g. `"text/html; charset=utf-8"`).
pub function content_type(path_or_ext: string, default_type: string = "application/octet-stream") -> string
    let ext = extract_ext(path_or_ext)
    let essence = ""
    if len(ext) > 0
        essence = db_lookup_ext(ext)
    end

    if len(essence) == 0
        essence = default_type
    end

    return format_content_type(essence)
end

## Reverse lookup: returns the default file extension for a MIME type.
##
## ### Parameters
## - `mime_type`: MIME type string (parameters tolerated).
##
## ### Returns
## The extension string (e.g. `"text/html"` yields `"html"`).
pub function extension(mime_type: string) -> string
    let s = _mime_trim(mime_type)
    let semi = _mime_index_of(s, ";")
    let essence = s
    if semi >= 0
        essence = substring(s, 0, semi)
    end
    essence = lower(_mime_trim(essence))
    return db_lookup_mime_ext(essence)
end

## Returns `1` when a path, extension, or MIME type is text-based.
##
## ### Parameters
## - `path_or_mime`: Path, extension, or MIME type string.
##
## ### Returns
## `1` for text types, `0` otherwise.
pub function is_text(path_or_mime: string) -> int
    let ext = extract_ext(path_or_mime)
    let essence = ""
    if len(ext) > 0
        essence = db_lookup_ext(ext)
    end

    if len(essence) == 0
        let s = _mime_trim(path_or_mime)
        let semi = _mime_index_of(s, ";")
        if semi >= 0
            s = substring(s, 0, semi)
        end
        essence = lower(_mime_trim(s))
    end

    return is_text_type(essence)
end

## Returns `1` when a path, extension, or MIME type is binary data.
##
## ### Parameters
## - `path_or_mime`: Path, filename, extension, or MIME type string.
##
## ### Returns
## `1` for binary types, `0` otherwise.
pub function is_binary(path_or_mime: string) -> int
    if is_text(path_or_mime) == 1
        return 0
    end
    return 1
end

## Returns the default charset for a path, extension, or MIME type.
##
## ### Parameters
## - `path_or_mime`: Path, extension, or MIME type string.
##
## ### Returns
## `"utf-8"` for text types, `""` otherwise.
pub function charset(path_or_mime: string) -> string
    let ext = extract_ext(path_or_mime)
    let essence = ""
    if len(ext) > 0
        essence = db_lookup_ext(ext)
    end

    if len(essence) == 0
        let s = _mime_trim(path_or_mime)
        let semi = _mime_index_of(s, ";")
        if semi >= 0
            s = substring(s, 0, semi)
        end
        essence = lower(_mime_trim(s))
    end

    return default_charset_for_mime(essence)
end

## Appends a charset parameter to a MIME essence string.
##
## ### Parameters
## - `mime_essence`: MIME essence string.
## - `charset_name`: Charset name. Defaults to `"utf-8"`.
##
## ### Returns
## The parameterized essence string.
pub function with_charset(mime_essence: string, charset_name: string = "utf-8") -> string
    let s = _mime_trim(mime_essence)
    return "{s}; charset={charset_name}"
end

## Parses a Content-Type header string into a `MimeType` instance.
##
## ### Parameters
## - `header_str`: Raw Content-Type header string.
##
## ### Returns
## The parsed `MimeType` instance.
pub function parse(header_str: string) -> MimeType
    return parse_content_type(header_str)
end

## Formats a `MimeType` instance back into a Content-Type string.
##
## ### Parameters
## - `mime_obj`: Target `MimeType` instance.
##
## ### Returns
## The Content-Type string with charset when present.
pub function format(mime_obj: MimeType) -> string
    if len(mime_obj.charset) > 0
        return "{mime_obj.essence}; charset={mime_obj.charset}"
    end
    return mime_obj.essence
end

# Types and data structures for mime
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

struct MimeType
    essence
    type_name
    subtype
    charset
    is_text
    is_binary
end

function mime_type_new(essence, type_name, subtype, charset = "", is_text = 0)
    let is_bin = 1
    if is_text == 1
        is_bin = 0
    end
    return MimeType {
        essence: essence,
        type_name: type_name,
        subtype: subtype,
        charset: charset,
        is_text: is_text,
        is_binary: is_bin
    }
end

function _mime_trim(s)
    let slen = len(s)
    if slen == 0
        return ""
    end
    let start_idx = 0
    while start_idx < slen
        let ch = char_at(s, start_idx)
        if ch != " " and ch != "\t" and ch != "\r" and ch != "\n"
            break
        end
        start_idx += 1
    end
    if start_idx >= slen
        return ""
    end
    let end_idx = slen - 1
    while end_idx >= start_idx
        let ch = char_at(s, end_idx)
        if ch != " " and ch != "\t" and ch != "\r" and ch != "\n"
            break
        end
        end_idx -= 1
    end
    return substring(s, start_idx, end_idx - start_idx + 1)
end

function _mime_clean_path(s)
    let trimmed = _mime_trim(s)
    let slen = len(trimmed)
    if slen == 0
        return ""
    end
    # Strip URL query string '?' and fragment '#'
    let clean_len = slen
    let i = 0
    while i < slen
        let ch = char_at(trimmed, i)
        if ch == "?" or ch == "#"
            clean_len = i
            break
        end
        i += 1
    end
    if clean_len < slen
        return substring(trimmed, 0, clean_len)
    end
    return trimmed
end

function _mime_index_of(haystack, needle)
    let hlen = len(haystack)
    let nlen = len(needle)
    if nlen == 0
        return 0
    end
    if nlen > hlen
        return -1
    end
    let max_idx = hlen - nlen
    let i = 0
    while i <= max_idx
        if substring(haystack, i, nlen) == needle
            return i
        end
        i += 1
    end
    return -1
end

function extract_ext(input_str)
    let s = _mime_clean_path(input_str)
    let slen = len(s)
    if slen == 0
        return ""
    end

    # Find last slash (/ or \)
    let last_slash = -1
    let i = slen - 1
    while i >= 0
        let c = char_at(s, i)
        if c == "/" or c == "\\"
            last_slash = i
            break
        end
        i -= 1
    end

    let filename = s
    if last_slash >= 0
        if last_slash == slen - 1
            return ""
        end
        filename = substring(s, last_slash + 1, slen - last_slash - 1)
    end

    let flen = len(filename)
    if flen == 0
        return ""
    end

    # Find last dot in filename
    let last_dot = -1
    let j = flen - 1
    while j >= 0
        if char_at(filename, j) == "."
            last_dot = j
            break
        end
        j -= 1
    end

    if last_dot >= 0
        if last_dot == flen - 1
            return ""
        end
        if last_dot == 0
            if last_slash >= 0
                return ""
            else
                return lower(substring(filename, 1, flen - 1))
            end
        end
        return lower(substring(filename, last_dot + 1, flen - last_dot - 1))
    end

    if last_slash >= 0
        return ""
    end

    return lower(filename)
end

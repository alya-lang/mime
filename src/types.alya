## # mime/types
##
## Types and data structures for MIME.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Defines media categories, the parsed `MimeType` model, and path and
## extension inspection helpers.

## Public enumeration of primary MIME categories.
pub enum MimeCategory
    Text = 1,
    Image = 2,
    Audio = 3,
    Video = 4,
    Application = 5,
    Font = 6,
    Model = 7,
    Multipart = 8,
    Other = 9
end

## Structured representation of a parsed MIME media type with parameters.
##
## ### Fields
## - `essence`: Full essence string (e.g. `"text/html"`).
## - `type_name`: Primary type segment (e.g. `"text"`).
## - `subtype`: Subtype segment (e.g. `"html"`).
## - `charset`: Charset parameter (e.g. `"utf-8"`), or `""`.
## - `is_text`: `1` for text-based types, `0` otherwise.
## - `is_binary`: `1` for binary types, `0` otherwise.
pub struct MimeType
    essence: string,
    type_name: string,
    subtype: string,
    charset: string,
    is_text: int,
    is_binary: int
end

## Returns `1` when this media type is text-based, `0` otherwise.
##
## ### Parameters
## - `self`: The target `MimeType` instance.
##
## ### Returns
## `1` for text types, `0` otherwise.
pub function MimeType.is_text(self: MimeType) -> int
    return self.is_text == 1
end

## Returns `1` when this media type is binary data, `0` otherwise.
##
## ### Parameters
## - `self`: The target `MimeType` instance.
##
## ### Returns
## `1` for binary types, `0` otherwise.
pub function MimeType.is_binary(self: MimeType) -> int
    return self.is_binary == 1
end

## Formats this `MimeType` back into a Content-Type string.
##
## ### Parameters
## - `self`: The target `MimeType` instance.
##
## ### Returns
## The Content-Type string with charset when present.
pub function MimeType.to_string(self: MimeType) -> string
    if len(self.charset) > 0
        return "{self.essence}; charset={self.charset}"
    end
    return self.essence
end

## Factory constructor building a `MimeType` with a derived binary flag.
##
## ### Parameters
## - `essence`: Full essence string.
## - `type_name`: Primary type segment.
## - `subtype`: Subtype segment.
## - `charset`: Charset parameter. Defaults to `""`.
## - `is_text`: `1` for text-based types. Defaults to `0`.
##
## ### Returns
## The new `MimeType` instance.
pub function mime_type_new(essence: string, type_name: string, subtype: string, charset: string = "", is_text: int = 0) -> MimeType
    let is_bin = 1
    if is_text == 1
        is_bin = 0
    end
    return MimeType {
        essence: essence,
        type_name: type_name,
        subtype: subtype,
        charset: charset,
        is_text: is_text,
        is_binary: is_bin
    }
end

## Trims leading and trailing whitespace from a string.
##
## ### Parameters
## - `s`: Input string.
##
## ### Returns
## The trimmed string.
pub function _mime_trim(s: string) -> string
    let slen = len(s)
    if slen == 0
        return ""
    end
    let start_idx = 0
    while start_idx < slen
        let ch = char_at(s, start_idx)
        if ch != " " and ch != "\t" and ch != "\r" and ch != "\n"
            break
        end
        start_idx += 1
    end
    if start_idx >= slen
        return ""
    end
    let end_idx = slen - 1
    while end_idx >= start_idx
        let ch = char_at(s, end_idx)
        if ch != " " and ch != "\t" and ch != "\r" and ch != "\n"
            break
        end
        end_idx -= 1
    end
    return substring(s, start_idx, end_idx - start_idx + 1)
end

## Cleans a path by trimming whitespace and stripping query/fragment parts.
##
## ### Parameters
## - `s`: Input path string.
##
## ### Returns
## The cleaned path string.
pub function _mime_clean_path(s: string) -> string
    let trimmed = _mime_trim(s)
    let slen = len(trimmed)
    if slen == 0
        return ""
    end
    # Strip URL query string '?' and fragment '#'
    let clean_len = slen
    let i = 0
    while i < slen
        let ch = char_at(trimmed, i)
        if ch == "?" or ch == "#"
            clean_len = i
            break
        end
        i += 1
    end
    if clean_len < slen
        return substring(trimmed, 0, clean_len)
    end
    return trimmed
end

## Finds the first index of a needle within a haystack (`-1` if absent).
##
## ### Parameters
## - `haystack`: Haystack string.
## - `needle`: Needle string.
##
## ### Returns
## The match index, or `-1` when absent (`0` for empty needles).
pub function _mime_index_of(haystack: string, needle: string) -> int
    let hlen = len(haystack)
    let nlen = len(needle)
    if nlen == 0
        return 0
    end
    if nlen > hlen
        return -1
    end
    let max_idx = hlen - nlen
    let i = 0
    while i <= max_idx
        if substring(haystack, i, nlen) == needle
            return i
        end
        i += 1
    end
    return -1
end

## Extracts a clean lowercased file extension from a path or URL.
##
## ### Parameters
## - `input_str`: Path, filename, or URL string.
##
## ### Returns
## The extension without dot (empty when absent).
##
## ### Examples
## ```alya
## say extract_ext("/a/b.html?x=1") # "html"
## ```
pub function extract_ext(input_str: string) -> string
    let s = _mime_clean_path(input_str)
    let slen = len(s)
    if slen == 0
        return ""
    end

    # Find last slash (/ or \)
    let last_slash = -1
    let i = slen - 1
    while i >= 0
        let c = char_at(s, i)
        if c == "/" or c == "\\"
            last_slash = i
            break
        end
        i -= 1
    end

    let filename = s
    if last_slash >= 0
        if last_slash == slen - 1
            return ""
        end
        filename = substring(s, last_slash + 1, slen - last_slash - 1)
    end

    let flen = len(filename)
    if flen == 0
        return ""
    end

    # Find last dot in filename
    let last_dot = -1
    let j = flen - 1
    while j >= 0
        if char_at(filename, j) == "."
            last_dot = j
            break
        end
        j -= 1
    end

    if last_dot >= 0
        if last_dot == flen - 1
            return ""
        end
        if last_dot == 0
            if last_slash >= 0
                return ""
            else
                return lower(substring(filename, 1, flen - 1))
            end
        end
        return lower(substring(filename, last_dot + 1, flen - last_dot - 1))
    end

    if last_slash >= 0
        return ""
    end

    return lower(filename)
end

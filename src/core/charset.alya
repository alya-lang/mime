## # mime/core/charset
##
## MIME charset and media classification.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "../types.alya"

## Returns `1` when a MIME essence is text-based, `0` otherwise.
##
## ### Parameters
## - `essence`: MIME essence string.
##
## ### Returns
## `1` for text types, `0` otherwise.
pub function is_text_type(essence: string) -> int
    let s = _mime_trim(essence)
    let slen = len(s)
    if slen >= 5 and substring(s, 0, 5) == "text/"
        return true
    end

    when s
        is "application/javascript", "text/javascript", "application/json", "application/ld+json", "application/manifest+json", "application/xml", "image/svg+xml", "application/x-sh", "application/sql", "application/x-httpd-php", "application/rtf" then return true
        else return false
    end
end

## Returns `1` when a MIME essence represents binary data, `0` otherwise.
##
## ### Parameters
## - `essence`: MIME essence string.
##
## ### Returns
## `1` for binary types, `0` otherwise.
pub function is_binary_type(essence: string) -> int
    if is_text_type(essence) == true
        return false
    end
    return true
end

## Returns the default charset (`"utf-8"` for text types, `""` otherwise).
##
## ### Parameters
## - `essence`: MIME essence string.
##
## ### Returns
## The default charset string.
pub function default_charset_for_mime(essence: string) -> string
    if is_text_type(essence) == true
        return "utf-8"
    end
    return ""
end

## Formats a full Content-Type header with a charset parameter when applicable.
##
## ### Parameters
## - `essence`: MIME essence string.
## - `custom_charset`: Override charset. Defaults to `""` (auto-detected).
##
## ### Returns
## The Content-Type header string.
pub function format_content_type(essence: string, custom_charset: string = "") -> string
    let cs = custom_charset
    if len(cs) == 0
        cs = default_charset_for_mime(essence)
    end
    if len(cs) > 0
        return "{essence}; charset={cs}"
    end
    return essence
end
